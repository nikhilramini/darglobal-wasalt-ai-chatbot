                    {
                        "@type": "Question",
                        "name": "How can I list my property on Wasalt?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "To list your property on Wasalt, start by creating an account, then entering property details, uploading photos, and setting prices, primarily through the Wasalt App, Wasalt Business App, or website. "
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "How do I log into my Wasalt account",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Click the profile icon (top left on the web or via the burger menu in the app). Enter your mobile number and complete OTP verification."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "What is Wasalt Auctions?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Wasalt Auctions is a feature where real estate assets are sold through timed auctions. Bidders can compete to determine the final sale price. Auctions include assets from private sellers and those in collaboration with Infath (Entrustment and Liquidation Center)."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "What is Matchmaker, and how does it work?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Matchmaker helps you find potential leads based on your live listings. It matches leads based on the property type, purpose, district, and category of your live property. Once your listing is live, Matchmaker will show leads that match those preferences, making it easier for you to connect with the right leads.\n"
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "What real estate services does Wasalt offer?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Wasalt is an AI-powered real estate portal for verified properties, projects, masterplans, online auctions, and daily rentals. Providing an enhanced search experience for users pursuing their ideal homes."
                        }
                    }
